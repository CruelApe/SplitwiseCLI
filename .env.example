# This is one way to configure the API key, mainly useful for CI/scripting. For
# everyday interactive use, you don't need this file at all: just run
# "splitwise config set-key" (or run any command with no key configured and it
# will prompt you) and the key is saved encrypted to your user profile instead.
#
# Copy this file to ".env" (in the same directory as SplitwiseCLI.csproj, or the
# directory you run "splitwise" from) and fill in your own values. ".env" is
# git-ignored so your real API key never gets committed.

# Personal Splitwise API key, used as a Bearer token. Obtain one from your
# Splitwise account / registered app at https://secure.splitwise.com/apps.
SPLITWISE_API_KEY=

# Optional. Overrides the currency code used for imported expenses instead of
# your Splitwise account's default currency (e.g. USD, EUR, GBP).
SPLITWISE_DEFAULT_CURRENCY=
